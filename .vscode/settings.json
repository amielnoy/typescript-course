{
  // משתמשים בגרסת TypeScript של הפרויקט (node_modules) ולא בזו שמגיעה עם VS Code
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,

  // שמירה אוטומטית – נוח כשמריצים תרגילים שוב ושוב
  "files.autoSave": "onFocusChange",

  "files.exclude": {
    "**/node_modules": true
  }
}
