{
  // F5 על קובץ .ts פתוח – מריץ אותו (עם tsx) במצב Debug, כולל עצירה ב-Breakpoints
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run current TypeScript file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
